{
  "name": "bagad-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "*"
  ],
  "scripts": {
    "generate-client": "openapi-generator-cli generate -i http://backend:8000/openapi.json -g typescript-fetch -o ./lib/ --additional-properties=supportsES6=true,npmName=bagad-client,nullSafeAdditionalProps=false",
    "build:lib": "yarn workspace bagad-client build",
    "build:app": "yarn workspace bagad-frontend build",
    "build": "yarn build:lib && yarn build:app",
    "dev": "yarn build:lib && yarn workspace bagad-frontend dev",
    "lint": "yarn workspace bagad-frontend lint"
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0"
  },
  "resolutions": {
    "**/vite": "^8.0.11"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
