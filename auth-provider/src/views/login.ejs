<form action="/interaction/<%= uid %>/login" method="post">
  <input type="hidden" name="method" value="password">

  <input required autocomplete="username webauthn" type="text" id="login" name="login" placeholder="Entrez votre email" <% if
    (!params.login_hint) { %>autofocus="on" <% } else { %> value="<%= params.login_hint %>" <% } %>>

  <input required type="password" id="password" name="password" placeholder="et votre mot de passe" <% if (params.login_hint) {
          %>autofocus="on" <% } %>>

  <button type="submit" class="login login-submit">Connexion</button>

  <div class="separator">OU</div>

  <input type="button" id="btnPasskey" value="Passkey" aria-describedby="passkey-helper">
  <small id="passkey-helper">
  </small>
</form>
<script src="https://unpkg.com/@simplewebauthn/browser"></script>
<script>
  const elemBegin = document.getElementById('btnPasskey');
  const elemHelper = document.getElementById('passkey-helper');

  async function passkeySignIn(conditional) {
    // Reset success/error messages
    elemHelper.innerHTML = '';

    // GET authentication options from the endpoint that calls
    // @simplewebauthn/server -> generateAuthenticationOptions()
    const resp = await fetch('/interaction/<%= uid %>/webauthn/challenge', {
      credentials: "same-origin",
    });
    const optionsJSON = await resp.json();

    let asseResp;
    try {
      // Pass the options to the authenticator and wait for a response
      asseResp = await SimpleWebAuthnBrowser.startAuthentication({
        optionsJSON,
        useBrowserAutofill: conditional
      });
    } catch (error) {
      if (error instanceof AbortError) {
        console.warning(`Error occured du auth flow: ${error}`)
      } else {
        // Some basic error handling
        elemHelper.innerText = error;
        throw error;
      }
    }

    // POST the response to the endpoint that calls
    // @simplewebauthn/server -> verifyAuthenticationResponse()
    const verificationResp = await fetch('/interaction/<%= uid %>/webauthn/verify', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        interaction: "<%= uid %>",
        response: asseResp
      }),
    });

    // Wait for the results of verification
    const verificationJSON = await verificationResp.json();

    // Show UI appropriate for the `verified` status
    if (verificationJSON && verificationJSON.verified) {
      elemHelper.innerHTML = 'Success!';
      window.location.href = verificationJSON.returnTo;
    } else {
      elemHelper.innerHTML = `Oh no, something went wrong! Response: <pre>${JSON.stringify(
        verificationJSON,
      )}</pre>`;
    }
  }

  // Start authentication when the user clicks a button
  elemBegin.addEventListener('click', () => passkeySignIn(false));

  // Start conditional ui
  if (window.PublicKeyCredential && PublicKeyCredential.isConditionalMediationAvailable) {
    // Check if conditional mediation is available.
    PublicKeyCredential.isConditionalMediationAvailable().then((isCMA) => {
      if (isCMA) {
        // Call WebAuthn authentication start endpoint
        passkeySignIn(true);
      }
    });
  }

</script>
